{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "featherdash/intro",
  "title": "Intro",
  "category": "featherdash",
  "icon": "editor-paragraph",
  "description": "Centered eyebrow, statement heading and supporting text.",
  "textdomain": "radicle",
  "supports": {
    "html": false,
    "align": ["full"]
  },
  "attributes": {
    "align": {
      "type": "string",
      "default": "full"
    },
    "anchor": {
      "type": "string",
      "default": ""
    },
    "eyebrow": {
      "type": "string",
      "default": ""
    },
    "heading": {
      "type": "string",
      "default": ""
    },
    "text": {
      "type": "string",
      "default": ""
    },
    "colors": {
      "type": "object",
      "default": {}
    }
  }
}
